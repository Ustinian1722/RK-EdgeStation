WORKER_PATH=/home/kickpi/projects/RK-EdgeStation/build/bin/rk_edge_worker
VIDEO_SOURCE=/home/kickpi/projects/RK-EdgeStation/.work/input.mp4
STATE_DIR=/home/kickpi/.local/state/rk-edge-station/demo
PORT=8080
ROI=0,0,1,1
CONFIDENCE=0.25
DWELL_MS=5000
ROI_DEBOUNCE_FRAMES=2
QUEUE_CAPACITY=1
QUEUE_POLICY=latest
